---
import ProdLayout from "../../layouts/ProdLayout.astro";
import SusHero from "../../components/prod/SusHero.astro";
import SusSectionV2 from "../../components/prod/SusSectionV2.astro";
import SusMediaHighlight from "../../components/prod/SusMediaHighlight.astro";
---

<ProdLayout title="Lipton Sustainability - Origin">
  <main class="sus-section-list" style="background-color: #000;">
    <SusSectionV2 background="image"  className="sus-hero-section">
      
      <SusHero 
      variant="origin"
      titleText="HOW DO WE <br> TAKE OUR TEA? <strong>SERIOUSLY</strong>"
      tagline="Sir Thomas Lipton chose Sri Lanka for his first tea estate in 1890. Renowned for its ideal climate, expert farmers and exceptional quality tea, Sri Lanka remains our heartland."
      handImageSrc="/images/lit-sp-origin-hero-desktop.png"
      handImageMobSrc="/images/lit-sp-origin-hero-mobile.png"
      handImageAlt="Lipton Ice Tea Bottle"
      />
    </SusSectionV2>

    <SusSectionV2 background="pink" className="sus-media-highlight-section">
      
      <SusMediaHighlight
        variant="sri-lanka"
        title="Sri Lanka <strong>with love</strong>"
        description="<p>Ceylon teas are famous for quality, variety, and sustainable production standards. Growing in seven regions across Sri Lanka, 1.5 million people work hard every day to produce it. </p> <h3>We’re thrilled to help fly the flag for, quite possibly, the finest black teas on earth.</h3>"

        imageSrc="/images/lit-sp-with-love-teaser.png"
      
        imageAlt="Lipton Ice Tea Bottle"
      />
    </SusSectionV2>
    
  </main>
  <div class="footer-placeholder"></div>
</ProdLayout>