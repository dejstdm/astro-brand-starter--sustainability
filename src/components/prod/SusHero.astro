---


export interface Props {
  variant?: 'home' | 'origin' | 'initiatives' | 'packaging';
  // Title can be provided as text or image (image takes precedence when both provided)
  titleText?: string;
  subtitleText?: string;
  titleImageSrc?: string;
  titleImageAlt?: string;

  // Optional tagline below the title
  tagline?: string;

  // Asset sources for the landing variant (externalized to page-level)
  bgImageSrc?: string;
  bgImageAlt?: string;
  leavesImageSrc?: string;
  handImageSrc?: string;
  handImageMobSrc?: string;
  handImageAlt?: string;
}

const {
  variant,
  titleText,
  subtitleText,
  titleImageSrc ,
  titleImageAlt ,
  tagline ,
  bgImageSrc = '/images/bg-sky 2.webp',
  bgImageAlt,
  leavesImageSrc,
  handImageSrc,
  handImageMobSrc,
  handImageAlt,
} = Astro.props as Props;
---


  <div class={`sus-hero sus-hero--${variant}`}>
    
    <!-- {variant === 'landing' && ( -->
      <div class="sus-hero__content">

        <div class="sus-hero__circle">
          <picture>
            <source srcset="/images/lipton-sun.webp" media="(min-width: 768px)">
            <source srcset="/images/lipton-sun-mob.webp" >
            <img src="/images/lipton-sun.webp" alt="Sun" class="sus-hero__sun">
          </picture>
        
            <div class="sus-hero__headlines">
              {titleText && (
                <h1 class="sus-hero__headline">
                  {titleImageSrc ? (
                    <>
                      <img
                        src={titleImageSrc}
                        alt={titleImageAlt}
                        class="sus-hero__headline-image"
                      />
                      <span class="sr-only">{titleText}</span>
                    </>
                  ) : (
                    // Need to display html tags
                    <span set:html={titleText} />
                  )}
                </h1>
              )}
              {subtitleText && <h3 class="sus-hero__subtitle">{subtitleText}</h3>}
              {tagline && <p class="sus-hero__tagline">{tagline}</p>}
            </div>
         
        </div>

        {/* if leaf present, show it */}
        {leavesImageSrc && (
          <div class="sus-hero__leaf-1">
            <img 
              src={leavesImageSrc}
              alt="" 
            />
          </div>
        )}

<!-- if initiatives version, then second leaf decoration image is needed -->
        {variant === 'initiatives' && (
          <div class="sus-hero__leaf-2">
            <img 
              src="/images/deco-leaves-2.webp"
              alt="" 
            />
          </div>
        )}
        <div class="sus-hero__hand">
          <picture>
                <source srcset={handImageSrc} media="(min-width: 768px)">
                <source srcset={handImageMobSrc} media="(max-width: 767px)">
                <img 
                  src={handImageMobSrc}
                  alt={handImageAlt}
                />
              </picture>
        </div>

      </div>
    {/* )} */}

  </div>

