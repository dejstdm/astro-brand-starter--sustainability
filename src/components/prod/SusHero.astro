---


export interface Props {
  variant?: 'landing' | 'origin' | 'initiatives-1' | 'initiatives-2';
  // Title can be provided as text or image (image takes precedence when both provided)
  titleText?: string;
  titleImageSrc?: string;
  titleImageAlt?: string;

  // Optional tagline below the title
  tagline?: string;

  // Asset sources for the landing variant (externalized to page-level)
  bgImageSrc?: string;
  bgImageAlt?: string;
  leavesImageSrc?: string;
  handImageSrc?: string;
  handImageAlt?: string;
}

const {
  variant = 'landing',
  titleText,
  titleImageSrc = '/images/REFRESHINGLY-RESPONSIBLE.png',
  titleImageAlt = 'Refreshingly Responsible',
  tagline = "THERE'S A TASTY MOUTHFUL",
  bgImageSrc = '/images/bg-sky 2.webp',
  bgImageAlt = '',
  leavesImageSrc = '/images/deco-leaves-1.webp',
  handImageSrc = '/images/sus-landing-hero.png',
  handImageAlt = 'Lipton Ice Tea Bottle',
} = Astro.props as Props;
---


  <div class={`sus-hero sus-hero--${variant}`}>
    
    {variant === 'landing' && (
      <div class="sus-hero__content">
        
        {/* <div class="sus-hero__bg">
          <img src={bgImageSrc} alt={bgImageAlt} class="sus-hero__bg-image" />
        </div> */}

        <div class="sus-hero__circle">
          <picture>
            <source srcset="/images/lipton-sun.webp" media="(min-width: 768px)">
            <source srcset="/images/lipton-sun-mob.webp" media="(max-width: 767px)">
            <img src="/images/lipton-sun.webp" alt="Sun" class="sus-hero__sun">
          </picture>
        
            <div class="sus-hero__headlines">
              {titleImageSrc ? (
                <img 
                  src={titleImageSrc} 
                  alt={titleImageAlt}
                  class="sus-hero__headline-image"
                />
              ) : titleText ? (
                <h1 class="sus-hero__headline">{titleText}</h1>
              ) : null}
              {tagline && <h2 class="sus-hero__tagline">{tagline}</h2>}
            </div>
          {/* <div class="sus-hero__circle-inner">
          </div> */}
        </div>

        <div class="sus-hero__leaf-1">
          <img 
            src={leavesImageSrc}
            alt="" 
           
          />
        </div>

        <div class="sus-hero__hand">
          <img 
            src={handImageSrc}
            alt={handImageAlt}
            
          />
        </div>

      </div>
    )}

  </div>

