            <img 
              src="https://api.builder.io/api/v1/image/assets/TEMP/4b0cd28384d9555f3f163fb94807d4e74436b75a?width=413" 
              alt="We Go" 
              class="sus-media-highlight__title-image sus-media-highlight__title-image--small"
            />
          </div>

          <div class="sus-media-highlight__main sus-media-highlight__main--centered">
            <div class="sus-media-highlight__circle">
