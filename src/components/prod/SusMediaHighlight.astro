  {variant === 'recycle' && (
    <>
      <div class="sus-container">
        <div class="sus-media-highlight__content sus-sec__content">
          
          <div class="sus-media-highlight__header sus-media-highlight__header--centered">
            <h2 class="sus-media-highlight__title">
              LET'S RECYCLE
            </h2>
          </div>

          <div class="sus-media-highlight__main">
            <div class="sus-media-highlight__media">
              <img 
                src="https://api.builder.io/api/v1/image/assets/TEMP/8a245466471d1bc1be0509a096def03a9ffd6c0a?width=1040" 
                alt="Recycling symbol with Lipton logo" 
                class="sus-media-highlight__recycle-logo"
              />
            </div>

            <div class="sus-media-highlight__text">
              <p class="sus-media-highlight__body">
                Once you've enjoyed a bottle of Lipton, please drop it in the (correct!) recycling bin. This helps keep our bottles in a nice closed loop, and well away from landfills.
              </p>
              <h3 class="sus-media-highlight__headline">
                EVERY BOTTLE COUNTS.
              </h3>
              <p class="sus-media-highlight__footnote">
                In our market, our bottles* are recyclable.<br>
                *Cap. label, and bottle are recyclable.
              </p>
            </div>
          </div>

        </div>
      </div>
    </>
  )}

</div>
