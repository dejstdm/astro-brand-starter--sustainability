---
export interface Props {
  variant?: 'sri-lanka' | 'round' | 'recycle';
}

const { variant = 'sri-lanka' } = Astro.props;
---

<div class={`sus-media-highlight sus-media-highlight--${variant} sus-sec`}>
  
  {variant === 'sri-lanka' && (
    <>
      <div class="sus-container">
        <div class="sus-media-highlight__content">
          
          <div class="sus-media-highlight__header">
            <h2 class="sus-media-highlight__title">
              FROM SRI LANKA
            </h2>
          </div>

          <div class="sus-media-highlight__main">
            <div class="sus-media-highlight__media">
            <img 
              src="/images/heart.png" 
              alt="With Love" 
              
            />
              
            </div>

            <div class="sus-media-highlight__text">
              <div class="wysiwyg-text">
              <p >
                Ceylon teas are famous for quality, variety, and sustainable production standards. Growing in seven regions across Sri Lanka, 1.5 million people work hard every day to produce it.
              </p>
              <h3 >
                We're thrilled to help fly the flag for, quite possibly, the finest black teas on earth.
              </h3>
              <p>In our market, our bottles* are recyclable.</p>
              <p>*Cap. label, and bottle are recyclable.</p>
              </div>
            </div>
          </div>

          <div class="sus-media-highlight__decoration">
            <img 
              src="https://api.builder.io/api/v1/image/assets/TEMP/134898a547c90dcb6943b776fe67ea68917e4a4f?width=299" 
              alt="" 
              class="sus-media-highlight__leaf"
            />
          </div>

        </div>
      </div>
    </>
  )}

  {variant === 'round' && (
