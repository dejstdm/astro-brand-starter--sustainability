---
export interface Props {
  variant?: 'sri-lanka' | 'round' | 'recycle';
  title?: string;
  description?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  variant ,
  title ,
  description,
  imageSrc,
  imageAlt 
} = Astro.props;
---

<div class={`sus-media-highlight sus-media-highlight--${variant} sus-sec`}>
  
 
    <>
      <div class="sus-container">
        <div class="sus-media-highlight__content">

          <div class="sus-media-highlight__header">
            <h2 class="sus-media-highlight__title">
             
              <span set:html={title} />
            </h2>
          </div>

          <div class="sus-media-highlight__main">
            <div class="sus-media-highlight__media">
            <img
              src={imageSrc}
              alt={imageAlt}
            />

            </div>

            <div class="sus-media-highlight__text">
              <div class="sus-media-highlight__decoration leaf-wiggle--fast">
                <img
                  src="https://api.builder.io/api/v1/image/assets/TEMP/134898a547c90dcb6943b776fe67ea68917e4a4f?width=299"
                  alt=""
                  class="sus-media-highlight__leaf"
                />
              </div>
              <div class="wysiwyg-text">
                <span set:html={description} />
             
              </div>
            </div>
          </div>

         

        </div>
      </div>
    </>
 

  

</div>
